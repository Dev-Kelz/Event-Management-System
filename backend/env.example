# Application Environment
# Options: development, staging, production
ENVIRONMENT=development

# Debug Mode (set to False in production)
DEBUG=True

# Secret Key for Session Management
# Generate a secure random key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-this-in-production

# Database Configuration
# PostgreSQL connection string format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@localhost:5432/your_database_name

# CORS Settings
# Comma-separated list of allowed origins (use * for development only)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Session Settings
# Session max age in seconds (default: 3600 = 1 hour)
SESSION_MAX_AGE=3600

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT=5/minute

# Optional: Monitoring and Error Tracking
# SENTRY_DSN=your-sentry-dsn-here

# Optional: Redis Configuration (for session storage)
# REDIS_URL=redis://localhost:6379/0

